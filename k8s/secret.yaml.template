# Kubernetes Secret Template
# DO NOT commit this file with actual values!
# Use: make k8s-generate-secret to create the actual secret
#
# To manually create the secret:
# kubectl create secret generic monorepo-secret \
#   --from-literal=JWT_SECRET='your-jwt-secret' \
#   --from-literal=AZURE_TENANT_ID='...' \
#   --from-literal=AZURE_CLIENT_ID='...' \
#   --from-literal=AZURE_CLIENT_SECRET='...' \
#   --from-literal=AZURE_REDIRECT_URI='https://api.your-domain.com/api/auth/oauth/microsoft/callback' \
#   --namespace=bun-hono-react

apiVersion: v1
kind: Secret
metadata:
  name: monorepo-secret
  namespace: bun-hono-react
  labels:
    app: monorepo
type: Opaque
stringData:
  # ==========================================================================
  # JWT Authentication (signs the access/refresh tokens we issue)
  # ==========================================================================
  # IMPORTANT: Generate a strong secret for production
  # openssl rand -base64 32
  JWT_SECRET: "your-jwt-secret-here-change-in-production-min-32-chars"

  # ==========================================================================
  # Microsoft Entra ID (Azure AD) OAuth
  # ==========================================================================
  # App registration: https://entra.microsoft.com -> App registrations
  AZURE_TENANT_ID: ""
  AZURE_CLIENT_ID: ""
  AZURE_CLIENT_SECRET: ""
  AZURE_REDIRECT_URI: "https://api.your-domain.com/api/auth/oauth/microsoft/callback"
