# Kubernetes Deployment Environment Variables
# Copy this file to .env.k8s and fill in your actual values
# DO NOT commit .env.k8s to version control!

# GitHub Container Registry Configuration
GITHUB_USER=your-github-username
GITHUB_TOKEN=ghp_your_github_personal_access_token

# Image Configuration
IMAGE_VERSION=latest
PROJECT_NAME=simple-sso

# Kubernetes Cluster Configuration
K8S_NAMESPACE=simple-sso
K8S_CONTEXT=your-kubernetes-context

# Secret values (consumed by `make k8s-generate-secret`)
# JWT signing key — generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-here-change-in-production
# Microsoft Entra ID (Azure AD) OAuth
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=https://sso-api.mstdev.my.id/api/auth/oauth/microsoft/callback

# Application Configuration (set in k8s/configmap.yaml)
ENVIRONMENT=production
SERVER_PORT=3000
# Server CORS allow-list + post-login redirect target
FRONTEND_URL=https://sso.mstdev.my.id
# The SPA calls the backend at this absolute URL
VITE_API_URL=https://sso-api.mstdev.my.id

# Deployment Configuration
REPLICAS=2

# Ingress (Traefik on k3s; TLS terminated upstream by Cloudflare Tunnel)
INGRESS_DOMAIN=sso.mstdev.my.id
INGRESS_API_DOMAIN=sso-api.mstdev.my.id
