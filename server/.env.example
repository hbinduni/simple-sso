# Server Environment Variables
# Copy this to .env and update with your values

# Environment
ENVIRONMENT=development
PORT=3000

# JWT Configuration (signs the access/refresh tokens we issue)
JWT_SECRET=dev-secret-key-change-in-production

# Frontend URL (for CORS + OAuth success redirect)
FRONTEND_URL=http://localhost:5173

# ===========================================================================
# Microsoft Entra ID (Azure AD) OAuth  [optional]
# ===========================================================================
# Leave blank to disable the "Sign in with Microsoft" endpoints. When all four
# are set, the server mounts GET /api/auth/oauth/microsoft (+ /callback).
# AZURE_REDIRECT_URI must be registered as a "Web" redirect URI on the app
# registration in the Entra admin center and must match exactly.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:3000/api/auth/oauth/microsoft/callback
